# API Base URL (para el POS con autenticación)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API URL del backend (sin /api/v1 para rutas de imágenes)
VITE_API_URL=http://localhost:3000

# Otras configuraciones
VITE_APP_NAME=ProsperPOS
VITE_UPLOAD_URL=http://localhost:3000/uploads

# Environment
NODE_ENV=development

# Nota: El frontend (template) corre en http://localhost:3001
# El backend (API) corre en http://localhost:3000
