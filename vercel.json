{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=6144 npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/vue/template/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.myprosperpos.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api.myprosperpos.com/uploads/:path*" },
    { "source": "/vue/template/:path*", "destination": "/vue/template/index.html" }
  ]
}
